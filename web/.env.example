# OnClaw web configuration. Copy to `web/.env` (gitignored).
# Values are read when the dev server or build starts; restart after changing.

# Absolute API origin, baked into the client bundle at build time.
# Leave unset to call the API same-origin ("/api/v1") - this is what the Vite dev
# proxy and same-origin reverse proxy setups want.
# Cross-origin values require CORS on the backend or a reverse proxy; the backend
# does not currently send CORS headers.
# VITE_API_URL=

# Dev server only: where the /api proxy forwards requests (vite.config.ts).
# VITE_API_PROXY_TARGET=http://localhost:8080

{
  "mcp": {
    "servers": {
      "wails": {
        "type": "stdio",
        "command": "wails3",
        "args": [
          "mcp"
        ]
      },
      "cu": {
        "type": "stdio",
        "command": "computer-use-mcp",
        "args": []
      }
    }
  },
  "hooks": {
    "enabled": true,
    "events": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "\"${ZCODE_PROJECT_DIR}/.zcode/skills/impeccable/scripts/impeccable\" hook",
              "enabled": true,
              "statusMessage": "Checking UI changes",
              "timeout": 5
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"${ZCODE_PROJECT_DIR}/.zcode/skills/impeccable/scripts/impeccable\" hook",
              "enabled": true,
              "statusMessage": "Design deep pass",
              "timeout": 30
            }
          ]
        }
      ]
    }
  }
}

# OnClaw backend configuration.
# Copy to `.env` in the repository root: cp .env.example .env
# `.env` is loaded automatically by every onclaw command and never overrides real
# environment variables. Do not commit `.env`.

# PostgreSQL connection DSN (required)
DATABASE_URL=postgres://postgres:password@localhost:5432/onclaw_v2?sslmode=disable

# HTTP listen address (flag: --listen-addr)
ONCLAW_LISTEN_ADDR=:8080

# JWT signing secret (HS256) (flag: --jwt-secret).
# Leave empty to use an ephemeral secret - sessions are invalidated on every restart.
ONCLAW_JWT_SECRET=

# Access token lifetime (flag: --token-ttl)
ONCLAW_TOKEN_TTL=24h

# Local file storage location and driver (flags: --data-dir, --storage-driver)
ONCLAW_DATA_DIR=./data
ONCLAW_STORAGE_DRIVER=local

# Initial superadmin, seeded on `onclaw server` startup if the master workspace has none.
ONCLAW_SUPERADMIN_EMAIL=
ONCLAW_SUPERADMIN_PASSWORD=

# Alternative to ONCLAW_SUPERADMIN_PASSWORD: read the password from this file instead.
# ONCLAW_SUPERADMIN_PASSWORD_FILE=./secrets/superadmin-password
